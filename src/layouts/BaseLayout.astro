---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Zhang Bokai Blog',
  description = 'Notes and essays by Zhang Bokai.',
} = Astro.props;

const pageTitle = title === 'Zhang Bokai Blog' ? title : `${title} | Zhang Bokai Blog`;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="Zhang Bokai Blog" href={`${base}rss.xml`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <p class="site-title"><a href={base}>Zhang Bokai Blog</a></p>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={base}>首页</a>
          <a href={`${base}rss.xml`}>RSS</a>
          <a href="https://github.com/zhang-bokai">GitHub</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Zhang Bokai. Built with Astro.</span>
      </footer>
    </div>
  </body>
</html>
